{
  "site_key": "hefei",
  "site_name": "合肥市公共资源交易中心",
  "base_url": "https://ggzy.hefei.gov.cn/",
  "category_page_url": "https://ggzy.hefei.gov.cn/jyxx/002001/002001001/moreinfo_jyxxgg2.html",
  "list_request": {
    "method": "GET",
    "url": "https://ggzy.hefei.gov.cn/jyxx/002001/002001001/moreinfo_jyxxgg2.html",
    "headers": {
      "User-Agent": "Mozilla/5.0"
    },
    "response_type": "html",
    "link_selector": "a[href*='/jyxx/002001/002001001/']",
    "title_keywords": ["招标公告"],
    "html_date_pattern": "/(\\d{8})/"
  },
  "date_filter": {
    "mode": "prefix",
    "list_date_key": "publish_time"
  },
  "attachment": {
    "enabled": true,
    "allowed_extensions": ["pdf"],
    "include_keywords": ["招标文件", "采购文件", "工程量清单", "清单", "答疑", "澄清", "补遗", "更正"],
    "exclude_keywords": ["异议", "投诉", "质疑", "复函", "立项", "批复", "核准", "审批", "操作手册"],
    "max_candidates": 3,
    "trigger_fields": [
      "open_date",
      "open_time",
      "signup_deadline",
      "project_region",
      "bid_region",
      "needs_construction_plan",
      "bid_method",
      "project_amount_wan",
      "qualification_level",
      "bid_bond_wan",
      "basic_account_guarantee",
      "builder_presentation",
      "performance_requirement",
      "payment_terms",
      "duration_days",
      "package_name"
    ],
    "max_file_size_bytes": 31457280
  },
  "fields": [
    {
      "name": "title",
      "label": "项目名称",
      "source": "list",
      "strategy": "list_key",
      "key": "title",
      "required": true,
      "postprocess": ["normalize_notice_title"]
    },
    {
      "name": "detail_url",
      "label": "公告链接",
      "source": "list",
      "strategy": "list_key",
      "key": "detail_url",
      "required": true,
      "postprocess": []
    },
    {
      "name": "open_date",
      "label": "开标日期",
      "source": "detail",
      "strategy": "regex",
      "pattern": "开标时间[^0-9]{0,20}((?:20[0-9]{2})\\s*年\\s*[0-9]{1,2}\\s*月\\s*[0-9]{1,2}\\s*日)",
      "required": false,
      "postprocess": ["normalize_cn_datetime_text"]
    },
    {
      "name": "open_time",
      "label": "开标时间",
      "source": "detail",
      "strategy": "regex",
      "pattern": "开标时间[^0-9]{0,20}(?:20[0-9]{2}\\s*年\\s*[0-9]{1,2}\\s*月\\s*[0-9]{1,2}\\s*日)\\s*([0-9]{1,2}\\s*(?:[:：]|时)\\s*[0-9]{2}\\s*分?)",
      "required": false,
      "postprocess": ["normalize_cn_datetime_text"]
    },
    {
      "name": "signup_deadline",
      "label": "报名截止日期",
      "source": "detail",
      "strategy": "regex",
      "pattern": "投标文件递交的截止时间[^0-9]{0,20}(?:为)?\\s*((?:20[0-9]{2})\\s*年\\s*[0-9]{1,2}\\s*月\\s*[0-9]{1,2}.{0,80}?日\\s*[0-9]{1,2}\\s*时\\s*[0-9]{2}\\s*分)",
      "required": false,
      "postprocess": ["normalize_cn_datetime_text"]
    },
    {
      "name": "project_region",
      "label": "项目所属地",
      "source": "detail",
      "strategy": "regex",
      "pattern": "建设地点[：: ]*((?:安徽省)?(?:合肥市)?[^。；\\n]{0,80}?(?:县|市|区|镇|乡|街道))",
      "required": false,
      "postprocess": ["normalize_region"]
    },
    {
      "name": "bid_region",
      "label": "开标地区",
      "source": "detail",
      "strategy": "regex",
      "pattern": "开标地点[：: ]*(?:[0-9]+\\.)?([^。；\\n]{0,120})",
      "required": false,
      "postprocess": ["normalize_bid_region"]
    },
    {
      "name": "needs_construction_plan",
      "label": "是否需要施组",
      "source": "detail",
      "strategy": "regex",
      "pattern": "([一二两2]个及以上施工组织设计|施工组织设计(?:（施工方案）)?(?:由投标人自行编制|文件|采用)?)",
      "required": false,
      "postprocess": ["mark_present"]
    },
    {
      "name": "bid_method",
      "label": "开标办法",
      "source": "detail",
      "strategy": "regex",
      "pattern": "(动态合理价格法|综合评估法|最低评标价法|经评审的最低投标价法)",
      "required": false,
      "postprocess": []
    },
    {
      "name": "project_amount_wan",
      "label": "项目金额（万）",
      "source": "detail",
      "strategy": "label_value",
      "aliases": ["合同估算价", "估算价", "招标控制价", "最高投标限价", "总投资", "投资规模", "项目投资"],
      "required": false,
      "postprocess": ["normalize_amount_value"]
    },
    {
      "name": "qualification_level",
      "label": "资质等级",
      "source": "detail",
      "strategy": "label_value",
      "aliases": ["投标人资质要求", "资质要求"],
      "required": false,
      "postprocess": []
    },
    {
      "name": "bid_bond_wan",
      "label": "保证金（万）",
      "source": "detail",
      "strategy": "regex",
      "pattern": "(免收|投标保证金[^0-9]{0,20}[0-9][0-9,\\.]*\\s*[万亿]?元)",
      "required": false,
      "postprocess": ["normalize_amount_value"]
    },
    {
      "name": "basic_account_guarantee",
      "label": "基本户保函",
      "source": "detail",
      "strategy": "regex",
      "pattern": "(基本户保函[^。；\\n]{0,50})",
      "required": false,
      "postprocess": []
    },
    {
      "name": "builder_presentation",
      "label": "建造师现场陈述/答辩",
      "source": "detail",
      "strategy": "regex",
      "pattern": "((?:项目经理|建造师)[^。；\\n]{0,30}(?:现场陈述|现场答辩|答辩)|现场陈述[^。；\\n]{0,30}(?:项目经理|建造师))",
      "required": false,
      "postprocess": []
    },
    {
      "name": "performance_requirement",
      "label": "业绩要求",
      "source": "detail",
      "strategy": "regex",
      "pattern": "(?:投标人业绩要求|项目经理业绩要求|业绩要求)[：: ]*([^。；\\n]+)",
      "required": false,
      "postprocess": []
    },
    {
      "name": "payment_terms",
      "label": "工程款支付方式",
      "source": "detail",
      "strategy": "label_value",
      "aliases": ["工程款支付方式", "付款方式", "支付方式"],
      "required": false,
      "postprocess": []
    },
    {
      "name": "duration_days",
      "label": "工期",
      "source": "detail",
      "strategy": "regex",
      "pattern": "(?:计划工期|工期)[：: ]*([0-9]+)\\s*日历天",
      "required": false,
      "postprocess": []
    },
    {
      "name": "package_name",
      "label": "文件包",
      "source": "detail",
      "strategy": "regex",
      "pattern": "(?:_?(\\d+包)_?|共划分\\s*(\\d+个标段))",
      "required": false,
      "postprocess": []
    }
  ]
}
