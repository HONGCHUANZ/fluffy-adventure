# MiniMax API Key (for 内容工厂 AI generation)
MINIMAX_API_KEY=your_minimax-api-key-here

# Turso Database (for Vercel deployment)
# Get these at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# For local development, leave the above empty
# The app will automatically use better-sqlite3 locally
