# 火山方舟 API Key (for 内容工厂 AI generation)
VOLCENGINE_API_KEY=your_volcengine_api_key_here

# Turso Database (for Vercel deployment)
# Get these at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# For local development, leave the above empty
# The app will automatically use better-sqlite3 locally

# 微信公众号 AppID 和 AppSecret（个人模式）
# 从 mp.weixin.qq.com → 设置与开发 → 基本配置 获取
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=your_wechat_app_secret_here
